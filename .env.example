# =============================================================================
# Risheh — environment template (PostgreSQL / Neon)
# راهنمای کامل فارسی: docs/DEPLOY-POSTGRES-FA.md
# =============================================================================

# ---- Database (Prisma + PostgreSQL / Neon) ----
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth (REQUIRED, ≥32 chars) — openssl rand -hex 32 ----
AUTH_SECRET=

# ---- Demo mode (گیت داده نمونه) ----
# true فقط روی دمو/Vercel-demo/Docker-smoke: seed داده نمونه + حساب‌های دمو + بنر نمایشی.
# هر مقدار دیگر: هیچ seed و هیچ کاربر پیش‌فرض ساخته نمی‌شود؛ ادمین با `bun run admin:create`.
DEMO_MODE=false

# ---- Payment gateway ----
# demo = درگاه نمایشی برچسب‌دار (پیش‌فرض). zarinpal = اسکلت TODO (فعال نمی‌شود مگر پیاده‌سازی شود).
PAYMENT_PROVIDER=demo
# کلیدهای درگاه واقعی (فقط برای go-live؛ بدون مقدار پیش‌فرض):
# PAYMENT_MERCHANT_ID=
# PAYMENT_TERMINAL_ID=
# PAYMENT_GATEWAY_KEY=

# ---- Cron (انقضای رزرو/سفارش/آگهی/اشتراک) ----
# vercel.json → /api/cron؛ هدر Authorization: Bearer <CRON_SECRET>. بدون این مقدار cron غیرفعال است.
# CRON_SECRET=

# ---- Secure uploads (S1) ----
# روی Vercel: Vercel Blob. بدون توکن، آپلود به دامنه محلی public/uploads می‌رود (Docker).
# BLOB_READ_WRITE_TOKEN=

# ---- Public base URL (sitemap/JSON-LD/درگاه‌های واقعی) ----
# NEXT_PUBLIC_BASE_URL=https://risheh-store.vercel.app

# ---- SMS / Email: در محدوده نیست (Won't) — هیچ کلیدی لازم نیست ----
