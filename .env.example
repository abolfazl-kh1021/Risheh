# =============================================================================
# Risheh — environment template (PostgreSQL / Neon edition)
# Copy this file to .env and fill in your own values.
# راهنمای کامل فارسی: docs/DEPLOY-POSTGRES-FA.md
# =============================================================================

# ---- Database (Prisma + PostgreSQL / Neon) ----
# Two connection strings for the SAME Neon database:
#
#  1) DATABASE_URL  → app runtime. Use the POOLED connection string from Neon
#     (Dashboard → Connection Details → "Pooled connection"). The host MUST
#     end with "-pooler". The `pgbouncer=true` flag tells Prisma to skip
#     prepared statements (required for PgBouncer transaction mode).
#     Serverless-safe defaults: connection_limit=5, pool_timeout=20, connect_timeout=15
#
#  2) DIRECT_DATABASE_URL → Prisma CLI only (migrate / db push / studio).
#     Use the DIRECT (non-pooled) connection string — same endpoint WITHOUT
#     "-pooler" in the host. DDL must not go through PgBouncer.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- Auth ----
# HMAC secret for signing session cookies. REQUIRED in production.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-in-production

# ---- Payment gateway (not configured in demo) ----
# Real gateway credentials (e.g. Zarinpal/Mellat/Zibal) go here when available.
# PAYMENT_MERCHANT_ID=
# PAYMENT_TERMINAL_ID=
# PAYMENT_GATEWAY_KEY=

# ---- SMS / OTP provider (not configured in demo) ----
# SMS_API_KEY=
# SMS_SENDER=

# ---- Email / newsletter delivery (not configured in demo) ----
# EMAIL_API_KEY=
