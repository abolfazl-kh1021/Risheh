generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL (Neon) — since the Vercel deployment.
  //
  //   DATABASE_URL            → pooled connection (Neon `-pooler` endpoint, PgBouncer)
  //                             used by Prisma Client at runtime.
  //   DIRECT_DATABASE_URL     → direct (non-pooled) connection, used by the Prisma
  //                             CLI for migrations (`migrate dev/deploy`, `db push`).
  //                             DDL must never go through PgBouncer's transaction pool.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============ Users & Auth ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  role          String   @default("BUYER") // BUYER | ARTISAN | ADMIN
  // Artisan (seller) profile fields
  shopTitle     String?  // e.g. کارگاه و نگارخانه استاد سهراب سپهری‌راد
  province      String?
  bio           String?
  avatar        String?
  planId        String?
  verified      Boolean  @default(false) // artisan identity verified
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  artworks      Artwork[]
  orders        Order[]         @relation("buyerOrders")
  cartItems     CartItem[]
  favorites     Favorite[]
  reviews       Review[]
  settlements   SettlementRequest[]
  memberRequest MemberRequest?
  labRequests   LabRequest[]
  sessions      Session[]
  discountRedemptions DiscountRedemption[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@map("sessions")
}

// ============ Catalog ============

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  tagline   String?
  image     String?
  order     Int     @default(0)

  artworks  Artwork[]

  @@map("categories")
}

model Artwork {
  id              String   @id @default(cuid())
  code            String   @unique // شناسه RSH-XXXX
  slug            String   @unique
  title           String
  sellerId        String
  seller          User     @relation(fields: [sellerId], references: [id])
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  description     String
  story           String?  // روایت اثر
  price           Int      // Toman
  compareAtPrice  Int?     // for discount display
  images          String   @default("[]") // JSON array of /assets/img/... paths
  materials       String?
  dimensions      String?
  yearMade        String?
  province        String?
  stock           Int      @default(1)
  status          String   @default("DRAFT") // DRAFT | PENDING | PUBLISHED | REJECTED | ARCHIVED | SOLD
  featured        Boolean  @default(false)
  rating          Float    @default(0)
  ratingCount     Int      @default(0)
  sizes           String?  // JSON size variants
  colors          String?  // JSON color variants
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authenticity    AuthenticityRecord?
  orderItems      OrderItem[]
  cartItems       CartItem[]
  favorites       Favorite[]
  reviews         Review[]
  labRequests     LabRequest[]
  discountLinks   DiscountArtwork[]

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("artworks")
}

model Review {
  id        String   @id @default(cuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  @@index([artworkId])
  @@map("reviews")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artworkId])
  @@index([artworkId])
  @@map("favorites")
}

// ============ Authenticity ============

model AuthenticityRecord {
  id            String   @id @default(cuid())
  artworkId     String   @unique
  artwork       Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  hologramCode  String   @unique // e.g. RSH-9834-HOLO
  status        String   @default("PENDING") // VERIFIED | PENDING | REJECTED
  labStatus     String   @default("QUEUED") // QUEUED | IN_LAB | TESTS_DONE | ISSUED
  tests         String   @default("[]") // JSON [{name, result, detail}]
  inspector     String?
  issuedAt      DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events        VerificationEvent[]

  @@map("authenticity_records")
}

model VerificationEvent {
  id        String   @id @default(cuid())
  recordId  String
  record    AuthenticityRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([recordId])
  @@map("verification_events")
}

model LabRequest {
  id        String   @id @default(cuid())
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  kind      String   // SAMPLE_SEND | PHOTO_SESSION
  preferredDate String?
  note      String?
  status    String   @default("NEW") // NEW | SCHEDULED | DONE | REJECTED
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@index([artworkId])
  @@map("lab_requests")
}

// ============ Cart & Orders ============

model CartItem {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKey  String?  // anonymous cart cookie key
  artworkId String
  artwork   Artwork  @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  variant   String?  // chosen size/color JSON
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([guestKey])
  @@map("cart_items")
}

model Order {
  id           String   @id @default(cuid())
  orderNumber  String   @unique // RSH-ORD-XXXX
  buyerId      String?
  buyer        User?    @relation("buyerOrders", fields: [buyerId], references: [id])
  buyerName    String
  buyerPhone   String
  address      String
  city         String
  postalCode   String?
  note         String?
  subtotal     Int      // server-computed, Toman
  discount     Int      @default(0)
  shipping     Int      @default(0)
  total        Int      // server-computed
  status       String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PAID | PREPARING | SHIPPED | DELIVERED | CANCELLED | PAYMENT_FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        OrderItem[]
  payments     PaymentAttempt[]
  tracking     TrackingEvent[]

  @@index([buyerId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id])
  titleSnapshot String
  imageSnapshot String
  unitPrice Int     // server-verified price at purchase time
  quantity  Int
  sellerId  String

  @@index([orderId])
  @@index([sellerId])
  @@map("order_items")
}

model PaymentAttempt {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway     String   @default("DEMO") // DEMO adapter — clearly labeled simulation
  authority   String   @unique // demo gateway token
  amount      Int
  status      String   @default("PENDING") // PENDING | SUCCESS | FAILED | CANCELLED
  refNumber   String?
  message     String?
  createdAt   DateTime @default(now())
  verifiedAt  DateTime?

  @@index([orderId])
  @@map("payment_attempts")
}

model TrackingEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  detail    String?
  actor     String
  createdAt DateTime @default(now())

  @@map("tracking_events")
}

// ============ Finance ============

model LedgerEntry {
  id        String   @id @default(cuid())
  sellerId  String
  orderId   String?
  kind      String   // SALE | COMMISSION | PAYOUT | SUBSCRIPTION
  amount    Int      // positive = credit, negative = debit (Toman)
  detail    String?
  status    String   @default("CLEARED") // CLEARED | PENDING
  createdAt DateTime @default(now())

  @@index([sellerId])
  @@map("ledger_entries")
}

model SettlementRequest {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation(fields: [sellerId], references: [id])
  amount    Int
  iban      String
  status    String   @default("PENDING") // PENDING | APPROVED | PAID | REJECTED
  adminNote String?
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@index([sellerId])
  @@map("settlement_requests")
}

// ============ Content ============

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String
  image     String?
  author    String
  category  String?
  readTime  Int      @default(5)
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("blog_posts")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

// ============ Artisan subscriptions (admin model) ============

model SubscriptionPlan {
  id        String  @id // bronze | silver | gold | national
  title     String
  tag       String?
  price     Int
  unit      String
  artworks  String
  support   String
  discount  String
  features  String  @default("[]") // JSON
  highlight Boolean @default(false)

  @@map("subscription_plans")
}

model MemberRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  workshop  String
  province  String
  portfolio String?
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime @default(now())
  decidedAt DateTime?

  @@map("member_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// ============ Discounts & occasion campaigns ============

/**
 * A curated occasion campaign (یلدا، نوروز، هفته میراث…) — the admin
 * (optionally with participating artisans) pins artworks to it.
 */
model DiscountCampaign {
  id          String   @id @default(cuid())
  title       String
  occasion    String // نوروز | یلدا | هفته میراث …
  description String?
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  codes    DiscountCode[]
  artworks DiscountArtwork[]

  @@map("discount_campaigns")
}

/**
 * A discount code — percent or fixed Toman, with caps, audience scope and
 * usage limits. Codes may belong to a campaign (occasion) or stand alone.
 */
model DiscountCode {
  id           String    @id @default(cuid())
  campaignId   String?
  campaign     DiscountCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  code         String    @unique // e.g. YALDA-1405
  title        String
  description  String?
  kind         String    @default("PERCENT") // PERCENT | FIXED
  amount       Int // percent (1-100) or Toman for FIXED
  maxPrice     Int? // cap on the discount amount (Toman) for PERCENT
  minPrice     Int? // minimum cart total to apply (Toman)
  audience     String    @default("ALL") // ALL | BUYER | ARTISAN
  maxUses      Int       @default(100)
  usedCount    Int       @default(0)
  perUserLimit Int       @default(1)
  startsAt     DateTime?
  expiresAt    DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  redemptions DiscountRedemption[]

  @@index([campaignId])
  @@map("discount_codes")
}

/** One row per code claim/use by a user (perUserLimit rows max per user). */
model DiscountRedemption {
  id        String       @id @default(cuid())
  codeId    String
  code      DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String       @default("CLAIMED") // CLAIMED | APPLIED
  createdAt DateTime     @default(now())

  @@index([codeId, userId])
  @@index([userId])
  @@map("discount_redemptions")
}

/** Join table: artworks pinned to an occasion campaign. */
model DiscountArtwork {
  id         String           @id @default(cuid())
  campaignId String
  campaign   DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  artworkId  String
  artwork    Artwork          @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([campaignId, artworkId])
  @@index([artworkId])
  @@map("discount_artworks")
}
